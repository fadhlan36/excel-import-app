generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// AUTH & USER
// ================================

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  // membuat relasi untuk audit trail (siapa saja yang buat/ubah konfigurasi)
  createdConfigurations ImportConfiguration[] @relation("ConfigCreatedBy")
  updatedConfigurations ImportConfiguration[] @relation("ConfigUpdatedBy")

  // relasi untuk history (siapa yang upload)
  importHistories ImportHistory[]
}

// ================================
// IMPORT CONFIGURATION MODEL
// ================================

enum ConfigStatus {
  ACTIVE
  INACTIVE
}

model ImportConfiguration {
  id          String       @id @default(cuid())
  name        String       // contoh: "Employee Import"
  description String?
  targetData  String       // label bebas, contoh: "employee", "customer", "asset"
  status      ConfigStatus @default(ACTIVE)

  // Audit Trail (mengecek siapa yang buat/ubah config)
  createdById String
  createdBy   User     @relation("ConfigCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  updatedById String?
  updatedBy   User?    @relation("ConfigUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  fieldMappings   FieldMapping[]
  importHistories ImportHistory[]

  @@map("import_configurations")
}

// ================================
// FIELD MAPPING
// ================================

enum DataType {
  STRING
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  DATETIME
}

enum ValidationType {
  NONE
  UNIQUE
  EMAIL
  DATE
}

model FieldMapping {
  id              String   @id @default(cuid())
  configurationId String
  configuration   ImportConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  excelColumn    String   // header di file Excel
  targetField    String   // nama field tujuan
  dataType       DataType
  isRequired     Boolean        @default(false)
  validationType ValidationType @default(NONE)
  columnOrder    Int            @default(0) // urutan kolom di template excel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // satu configuration tidak boleh punya 2 mapping ke target field yang sama
  @@unique([configurationId, targetField])
  @@map("field_mappings")
}

// ================================
// IMPORT HISTORY
// ================================

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model ImportHistory {
  id              String   @id @default(cuid())
  configurationId String
  configuration   ImportConfiguration @relation(fields: [configurationId], references: [id])

  fileName     String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  totalRows   Int          @default(0)
  successRows Int          @default(0)
  failedRows  Int          @default(0)
  status      ImportStatus @default(PROCESSING)

  records ImportedRecord[]
  errors  ImportError[]

  @@map("import_histories")
}

// ================================
// HASIL DATA
// ================================

enum RowStatus {
  SUCCESS
  FAILED
}

model ImportedRecord {
  id              String        @id @default(cuid())
  importHistoryId String
  importHistory   ImportHistory @relation(fields: [importHistoryId], references: [id], onDelete: Cascade)

  rowNumber Int
  data      Json      // hasil final per baris
  status    RowStatus

  createdAt DateTime @default(now())

  @@map("imported_records")
}

// ================================
// ERROR REPORT
// ================================

model ImportError {
  id              String        @id @default(cuid())
  importHistoryId String
  importHistory   ImportHistory @relation(fields: [importHistoryId], references: [id], onDelete: Cascade)

  row     Int
  field   String
  value   String?
  message String

  createdAt DateTime @default(now())

  @@map("import_errors")
}